<!-- ClickHouse's built-in Prometheus endpoint: current metrics, profile event counters and
     asynchronous metrics from system tables, served by the server itself. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
