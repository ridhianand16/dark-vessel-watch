REDPANDA_BROKERS=localhost:19092
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dvw
CLICKHOUSE_PASSWORD=change-me
AIS_DATA_DIR=./data/ais
# Pinned DMA day (must match dma_ais.version in refdata/sources.yaml)
AIS_DAY=2026-10-28
REFDATA_DIR=./data/refdata
AISSTREAM_API_KEY=

# PostGIS. The postgis container reads USER/PASSWORD/DB to initialise the
# database; application code builds its DSN from all five (no POSTGRES_DSN,
# so there is one source of truth).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dvw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dvw
